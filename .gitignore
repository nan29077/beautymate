# Dependencies
node_modules/

# Environment
# ⚠️ 신규 저장소(beautymate)는 공개 저장소이므로 .env 계열은 절대 커밋하지 않는다.
#    (운영 DATABASE_URL·AUTH_SECRET·PG 상점키 등이 들어 있음)
.env
.env.*
!.env.example

# Build
dist/
build/
.next/
out/
*.tsbuildinfo

# Prisma 생성 클라이언트 — 빌드 산출물이라 커밋하지 않는다.
# 서버 배포(deploy.sh)와 npm install(postinstall)이 매번 재생성하므로,
# 커밋해두면 스키마가 바뀔 때마다 서버의 재생성분과 git pull 이 충돌한다.
src/generated/
.wrangler/

# 업로드 파일 (사용자 업로드 — 저장소에 담지 않음)
public/uploads/*
!public/uploads/.gitkeep

# 로컬 산출물/임시 폴더
tmp/
output/
_trash_temp/
_legacy_sajunara_assets/
logs/
pids/
.pm2/

# DB 백업 (고객 개인정보 포함 — 커밋 금지)
backups/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 일회성 헬퍼 스크립트/메모 (작업 중 생성 — 커밋 금지)
# 정식 스크립트는 scripts/ 폴더에 두면 추적됨
*.bat
*.vbs
!/scripts/*.bat
# 개발 서버 재시작 런처 (더블클릭 실행용 — 루트에 있어야 해서 예외 처리)
!/restart_dev.bat
/*.ps1
/*.py
/*.zip
/__*.txt
/*-result.txt
/git_*.txt
/test*.txt
/*완료*.txt
/*필요*.txt
/*확인*.txt
/*정산*.txt

# 루트 바이너리 문서 (별도 보관)
/*.pptx
/*.docx
/*.pdf

# Prisma 임시 검사 스크립트
/prisma/_inspect-*

# LibreOffice 잠금 파일
.~lock.*#

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
htmlcov/
.coverage

# 로컬 개발 서버 로그
/dev-server.out.log
/dev-server.err.log
