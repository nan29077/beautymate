# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/beautymate"

# NextAuth
AUTH_SECRET="your-super-secret-key-change-in-production"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="뷰티메이트"

# SeedPay (PG)
# 테스트: SEEDPAY_IS_PRODUCTION=false
# 운영: SEEDPAY_IS_PRODUCTION=true
SEEDPAY_MID=""
# SEEDPAY_GID: 그룹 ID (현재 결제창 flow 에선 미사용, 향후 대비)
SEEDPAY_GID=""
SEEDPAY_MERCHANT_KEY=""
SEEDPAY_IS_PRODUCTION="false"

# Smartro SSPay (PG) — 간편결제 + 신용카드
# 테스트: SMARTROPAY_IS_PRODUCTION=false
# 운영: SMARTROPAY_IS_PRODUCTION=true
SMARTROPAY_MID=""
SMARTROPAY_MERCHANT_KEY=""
# SspMallId — 간편결제 전용 가맹점 ID (10자 이내, MID와 별도). 영업담당 발급.
# 미설정 시 매뉴얼의 테스트 공용값 SMTSSPAY0p 자동 사용.
SMARTROPAY_SSP_MALL_ID=""
SMARTROPAY_IS_PRODUCTION="false"

# ONGI 간편 계좌결제
# ONGI_MID: 가맹점 ID (영업담당 발급)
# ONGI_API_KEY: ONGI API 인증 키 (조회/검증용)
# ONGI_QR_CODE: 가맹점별 QR 식별자 (pay.ongi.site/#/qr/{ONGI_QR_CODE}) — MID 와 별개
# ONGI_PAY_URL: 결제창 호스트 (기본: https://pay.ongi.site)
# ONGI_API_BASE: ONGI 조회/검증 API base (기본: https://www.ongi.site/api)
ONGI_MID=""
ONGI_API_KEY=""
ONGI_QR_CODE=""
ONGI_PAY_URL="https://pay.ongi.site"
ONGI_API_BASE="https://www.ongi.site/api"

# ─────────────────────────────────────────────
# 간편로그인 (OAuth)
# - 키가 모두 비어있으면 해당 provider 버튼은 자동 숨김 (앱은 정상 동작)
# - Redirect URI 는 NextAuth 표준: /api/auth/callback/<provider>
# ─────────────────────────────────────────────

# 카카오 — https://developers.kakao.com
# 1) 내 애플리케이션 → 추가 → REST API 키 발급
# 2) 카카오 로그인 활성화, 동의 항목: 이메일·프로필
# 3) Redirect URI 등록: http://localhost:3000/api/auth/callback/kakao
#                       https://<prod-host>/api/auth/callback/kakao
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# 네이버 — https://developers.naver.com/apps
# 1) 애플리케이션 등록 → 사용 API: 네이버 로그인
# 2) 회원정보 권한: 이메일 주소, 이름
# 3) Callback URL 등록: http://localhost:3000/api/auth/callback/naver
#                       https://<prod-host>/api/auth/callback/naver
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# 구글 — https://console.cloud.google.com/apis/credentials
# 1) OAuth 클라이언트 ID 만들기 (애플리케이션 유형: 웹)
# 2) 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
#                          https://<prod-host>/api/auth/callback/google
# 3) OAuth 동의 화면에서 이메일/프로필 스코프 사용
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# 알리고 카카오 알림톡 (라이브 방송시작 알림)
# https://smartsms.aligo.in → 카카오 알림톡 → 발신프로필/템플릿 등록 후 발급
# ALIGO_TEST_MODE="true" 이면 실제 발송 없이 테스트 모드로 호출됨
# ─────────────────────────────────────────────
ALIGO_API_KEY=""
ALIGO_USER_ID=""
ALIGO_SENDER_KEY=""
ALIGO_SENDER=""
ALIGO_LIVE_START_TPL_CODE=""
ALIGO_TEST_MODE="false"

# ─────────────────────────────────────────────
# Daily.co 영상 상담 (1:1 WebRTC)
# https://dashboard.daily.co/developers → API 키 발급
# DAILY_DOMAIN: Daily 대시보드의 서브도메인 (예: beautymate → beautymate.daily.co)
# 미설정 시 영상 상담 세션은 데모 모드로 생성됩니다 (실제 통화 불가, 개발용)
# ─────────────────────────────────────────────
DAILY_API_KEY=""
DAILY_DOMAIN=""

# ─────────────────────────────────────────────
# YouTube Data API v3 (라이브 자동 감지 · 라이브 채팅 읽기)
# https://console.cloud.google.com/apis/credentials → API 키 생성
# → YouTube Data API v3 사용 설정 필요
# 미설정 시 채널 자동 감지(방식 B)와 YouTube 채팅 표시가 비활성화됩니다 (앱은 정상 동작)
# ─────────────────────────────────────────────
YOUTUBE_API_KEY=""
